# Copy this file to .env and fill in the values. Never commit .env.

# Required for every AI feature (research with web search, summaries, quizzes, tutor, OCR of scanned pages).
# Get a key at https://platform.claude.com/ → API Keys.
ANTHROPIC_API_KEY=

# Optional: override the model (default claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: server-side refusal fallback ("default" or "off"). Default: default.
# AI_REFUSAL_FALLBACK=default

# Optional: Google Books API key (raises the anonymous rate limit for book identification).
# GOOGLE_BOOKS_API_KEY=

# Optional: port and data directory.
# PORT=3000
# DATA_DIR=./data

# Optional: max upload size in MB (default 150).
# MAX_UPLOAD_MB=150

# Optional: material size (characters) above which summaries switch to chunked, hierarchical processing.
# SINGLE_PASS_MAX_CHARS=300000

# Optional: use another provider instead of Anthropic.
# For Radox AI (OpenAI-compatible):
# AI_PROVIDER=openai
# AI_BASE_URL=https://radoxai.com/v1
# AI_API_KEY=cc_...
# AI_MODEL=<model name from your Radox AI dashboard>
# Web research for books and OCR of scanned PDFs still need an Anthropic key.
